{
  "mcpServers": {
    "news": {
      "command": "npx",
      "args": [
        "tsx",
        "--env-file=.env",
        "packages/mcp/src/bin.ts"
      ],
      "env": {},
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "disabled": false
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "V:/video_tool"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "read_media_file"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {},
      "disabled": false
    }
  }
}