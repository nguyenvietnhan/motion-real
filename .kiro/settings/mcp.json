{
  "mcpServers": {
    "news": {
      "command": "npx",
      "args": [
        "tsx",
        "--env-file=.env",
        "packages/mcp/src/bin.ts"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "doctor",
        "list_projects",
        "ingest_url",
        "tracker_update",
        "tracker_list",
        "scaffold_project",
        "render_full",
        "render_draft"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_console_messages",
        "browser_take_screenshot",
        "browser_run_code_unsafe",
        "browser_close",
        "browser_click"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "V:/video_tool"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "read_media_file",
        "move_file",
        "create_directory"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {},
      "disabled": false
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@latest"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "sequentialthinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@latest"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "create_entities",
        "create_relations",
        "add_observations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ]
    }
  }
}