{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "paths": {
      "@motionreal/schema": ["./packages/schema/src/index.ts"],
      "@motionreal/theme": ["./packages/theme/src/index.ts"],
      "@motionreal/blocks": ["./packages/blocks/src/index.ts"],
      "@motionreal/tts": ["./packages/tts/src/index.ts"],
      "@motionreal/tts/vieneu-presets": ["./packages/tts/src/vieneu-presets.ts"],
      "@motionreal/compositions": ["./packages/compositions/src/index.ts"],
      "@motionreal/compositions/*": ["./packages/compositions/src/*"],
      "@motionreal/pipeline": ["./packages/pipeline/src/index.ts"],
      "@motionreal/pipeline/*": ["./packages/pipeline/src/*"]
    }
  },
  "include": ["apps/**/*", "packages/**/*", "scripts/**/*"],
  "exclude": ["**/__fixtures__/**"]
}
