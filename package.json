{
  "name": "motionreal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AI-driven short-form video generator built on Remotion (React) for diverse, code-generated visuals.",
  "author": "Nguyen Viet Nhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenvietnhan/news_remotion_tool.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenvietnhan/news_remotion_tool/issues"
  },
  "homepage": "https://github.com/nguyenvietnhan/news_remotion_tool#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "studio": "npm --workspace @motionreal/remotion run studio",
    "render": "npm --workspace @motionreal/remotion run render",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "vitest run --config vitest.browser.config.ts --maxWorkers=1",
    "build:remotion": "tsx scripts/build.ts",
    "build:desktop": "npm --workspace @motionreal/desktop run build:main && npm --workspace @motionreal/desktop run build:renderer",
    "build": "npm run build:remotion && npm run build:desktop",
    "test": "tsx scripts/test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:vieneu": "tsx scripts/smoke-vieneu.ts",
    "calibrate:voice": "tsx scripts/calibrate-voice.ts",
    "vendor-fonts": "tsx scripts/vendor-fonts.ts"
  },
  "devDependencies": {
    "@motionreal/schema": "0.1.0",
    "@remotion/bundler": "4.0.481",
    "@remotion/google-fonts": "4.0.481",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.11",
    "fast-check": "^3.23.2",
    "playwright": "1.58.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
