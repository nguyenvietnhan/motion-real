# --- AI Planner (OpenAI-compatible) ---
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# DeepSeek preset: set AI_PROVIDER=deepseek. Defaults become:
# AI_API_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash

# --- Vivibe / LucyLab TTS (either naming style is accepted) ---
VIVIBE_API_KEY=
VIVIBE_BASE_URL=https://api.lucylab.io/json-rpc
VIVIBE_VOICE_ID=
VIETNAMESE_API_KEY=
VIETNAMESE_VOICEID=
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc
LUCYLAB_POLL_INTERVAL_MS=2000
LUCYLAB_POLL_TIMEOUT_MS=300000

# --- Project storage ---
VIDEO_TOOL_HOME=.video-tool

# --- Optional BGM ---
# VIDEO_TOOL_BGM_PATH=
# VIDEO_TOOL_BGM_VOLUME=0.10
